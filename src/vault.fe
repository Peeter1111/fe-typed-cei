use ingot::assets::native
use ingot::ledger::{Ledger, balance_of, commit_split, credit, withdraw_and_dispatch}

pub msg VaultMsg {
    #[selector = sol("deposit()")]
    Deposit,
    #[selector = sol("withdraw(address)")]
    Withdraw { to: Address } -> u256,
    #[selector = sol("withdrawSplit(address,address,uint256)")]
    WithdrawSplit { to_a: Address, to_b: Address, amount_a: u256 } -> u256,
    #[selector = sol("balanceOf(address)")]
    BalanceOf { owner: Address } -> u256,
}

/// Worked example: no lock slot and no external-call capability in accounting.
pub contract TypedVault uses (ctx: Ctx, call: mut Call) {
    mut ledger: Ledger,

    recv VaultMsg {
        #[payable]
        Deposit uses (ctx, mut ledger) {
            credit(owner: ctx.caller(), amount: ctx.value().as_wei())
        }

        Withdraw { to } -> u256 uses (ctx, mut call, mut ledger) {
            withdraw_and_dispatch(owner: ctx.caller(), to, asset: native())
        }

        WithdrawSplit { to_a, to_b, amount_a } -> u256
        uses (ctx, mut call, mut ledger)
        {
            let total = balance_of(owner: ctx.caller())
            let (first, second) = commit_split(
                owner: ctx.caller(),
                to_a,
                to_b,
                amount_a,
                asset_a: native(),
                asset_b: native(),
            )
            first.dispatch()
            second.dispatch()
            total
        }

        BalanceOf { owner } -> u256 uses (ledger) {
            balance_of(owner)
        }
    }
}
