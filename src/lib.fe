//! Typed checks-effects-interactions for Fe.
//!
//! Accounting code can mint an opaque `Payout` only after it commits a debit.
//! Dispatch consumes that payout and carries the external-call effects separately.

pub use assets::{Asset, Erc20Asset, Native, erc20_asset, native}
pub use ledger::{
    Ledger,
    Payout,
    balance_of,
    commit_split,
    commit_withdraw,
    credit,
    withdraw_and_dispatch,
}
pub use vault::{TypedVault, VaultMsg}
pub use token_vault::{TokenVault, TokenVaultMsg}
pub use auction::{AuctionMsg, RefundAuction}
