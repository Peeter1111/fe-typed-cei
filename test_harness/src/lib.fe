#[test(balance = 10_000_000_000_000_000_000)]
fn transient_guard_blocks_cross_function() uses (evm: mut Evm) {
    let vault = evm.create2<TransientGuardVault>(value: Wei::zero(), args: (), salt: 91)
    check_cross_function(
        vault,
        expected_attempts: 1,
        expected_successes: 0,
        expected_view: ether(1).as_wei(),
        expected_eth: ether(2),
    )
}

fn check_cross_function(
    vault: Address,
    expected_attempts: u256,
    expected_successes: u256,
    expected_view: u256,
    expected_eth: Wei,
)
uses (evm: mut Evm)
{
    evm.call(
        addr: vault,
        gas: 300000,
        value: ether(2),
        message: VaultMsg::Deposit {},
    )
    let attacker = evm.create2<ReentrantAttacker>(value: Wei::zero(), args: (vault,), salt: 80)
    evm.call(
        addr: attacker,
        gas: 1500000,
        value: ether(1),
        message: AttackMsg::AttackCross { rounds: 2, amount_a: ether(1).as_wei() / 2 },
    )
    let attempts: u256 = evm
        .call(
            addr: attacker,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Attempts {},
        )
    let successes: u256 = evm
        .call(
            addr: attacker,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Successes {},
        )
    let seen: u256 = evm
        .call(
            addr: attacker,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::ObservedBalance {},
        )
    let reads: u256 = evm
        .call(
            addr: attacker,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Reads {},
        )
    let victim_claim: u256 = evm
        .call(
            addr: vault,
            gas: 100000,
            value: Wei::zero(),
            message: VaultMsg::BalanceOf { owner: evm.address() },
        )
    assert!(attempts == expected_attempts)
    assert!(successes == expected_successes)
    assert!(reads == expected_attempts)
    assert!(seen == expected_view)
    assert!(victim_claim == ether(2).as_wei())
    assert!(evm.balance(vault) == expected_eth)
    assert!(evm.balance(attacker) == ether(3) - expected_eth)
}

#[test(balance = 10_000_000_000_000_000_000)]
fn cross_function_typed() uses (evm: mut Evm) {
    let vault = evm.create2<TypedVault>(value: Wei::zero(), args: (), salt: 81)
    check_cross_function(
        vault,
        expected_attempts: 1,
        expected_successes: 0,
        expected_view: 0,
        expected_eth: ether(2),
    )
}

