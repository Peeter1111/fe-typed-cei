fn check_read_only(vault: Address, expected_view: u256) uses (evm: mut Evm) {
    evm.call(
        addr: vault,
        gas: 300000,
        value: ether(2),
        message: VaultMsg::Deposit {},
    )
    let attacker = evm.create2<ReentrantAttacker>(value: Wei::zero(), args: (vault,), salt: 85)
    evm.call(
        addr: attacker,
        gas: 600000,
        value: ether(1),
        message: AttackMsg::AttackReadOnly {},
    )
    let seen: u256 = evm
        .call(
            addr: attacker,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::ObservedBalance {},
        )
    let reads: u256 = evm
        .call(
            addr: attacker,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Reads {},
        )
    let attempts: u256 = evm
        .call(
            addr: attacker,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Attempts {},
        )
    assert!(reads == 1 && attempts == 0)
    assert!(seen == expected_view)
    assert!(evm.balance(vault) == ether(2))
    assert!(evm.balance(attacker) == ether(1))
}

#[test(balance = 10_000_000_000_000_000_000)]
fn readonly_callback_typed() uses (evm: mut Evm) {
    let vault = evm.create2<TypedVault>(value: Wei::zero(), args: (), salt: 86)
    check_read_only(vault, expected_view: 0)
}

